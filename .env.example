# =============================================================================
# CONFIGURAÇÕES DO DJANGO - CONTROLE DE ACESSO
# Configurável para qualquer Unidade Prisional
# =============================================================================

# SEGURANÇA
# Em desenvolvimento: opcional (uma chave aleatória é gerada a cada restart).
# Em produção (DJANGO_DEBUG=False): OBRIGATÓRIO. O sistema aborta o boot se
# não estiver definido, evitando sessões inválidas a cada iisreset.
# Gere uma com: python manage.py check_secret_key --generate
# DJANGO_SECRET_KEY=sua-chave-secreta-super-forte-aqui

# AMBIENTE
# Em produção defina DJANGO_DEBUG=False (o sistema valida SECRET_KEY/HOSTS
# automaticamente e aborta o boot se faltarem).
DJANGO_DEBUG=True
DJANGO_ENVIRONMENT=development

# HOSTS PERMITIDOS (separe por vírgula para múltiplos hosts)
# Em desenvolvimento: localhost,127.0.0.1
# Em produção: seu-dominio.com,www.seu-dominio.com
# ATENÇÃO: '*' é bloqueado em produção pelo settings.py (DJANGO_DEBUG=False).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# =============================================================================
# BANCO DE DADOS
# =============================================================================

# Para SQLite (padrão): sqlite:///caminho/para/db.sqlite3
# Para PostgreSQL: postgresql://usuario:senha@host:porta/nome_banco
# Para MySQL: mysql://usuario:senha@host:porta/nome_banco
DATABASE_URL=sqlite:///db.sqlite3

# =============================================================================
# CONFIGURAÇÕES DE SESSÃO
# =============================================================================

# Tempo de expiração da sessão em segundos
SESSION_COOKIE_AGE=14400

# Forçar logout quando o navegador é fechado
SESSION_EXPIRE_AT_BROWSER_CLOSE=True

# Salvar sessão a cada requisição
SESSION_SAVE_EVERY_REQUEST=True

# Cookies seguros (True apenas em HTTPS)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# =============================================================================
# LOCALIZAÇÃO
# =============================================================================

# Idioma da aplicação
LANGUAGE_CODE=pt-br

# Fuso horário
TIME_ZONE=America/Manaus

# =============================================================================
# ARQUIVOS ESTÁTICOS
# =============================================================================

# Servir arquivos estáticos pelo Django (True em desenvolvimento)
SERVE_STATIC_FILES=True

# =============================================================================
# INTEGRAÇÃO CANAIMÉ
# =============================================================================

# URLs base do sistema Canaimé
CANAIME_BASE_URL=https://canaime.com.br
CANAIME_LOGIN_URL=https://canaime.com.br/sgp2rr/login/login_principal.php
CANAIME_AREAS_URL=https://canaime.com.br/sgp2rr/areas/unidades/index.php

# =============================================================================
# LOGGING
# =============================================================================

# Diretório de logs (relativo ao projeto)
LOGS_DIR=logs

# Nível de log (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# NOTIFICAÇÕES
# =============================================================================

# URL do webhook do Discord para notificações de erros
DISCORD_WEBHOOK_URL=sua-url-do-webhook-aqui

# =============================================================================
# E-MAIL (SMTP) - envio de credenciais de novos usuarios / reset de senha
# =============================================================================
# Em desenvolvimento, deixe EMAIL_HOST vazio para que os emails sejam
# impressos no stdout (backend console). Em produção, preencha as
# variáveis abaixo com os dados do provedor escolhido.
#
# Provedor principal deste projeto: GMAIL (app password)
#   - Limite: ~500 emails/dia (conta pessoal) ou 2.000/dia (Google Workspace).
#     Suficiente para ~150 senhas/dia - sobra para o volume atual da PAMC.
#   - SMTP: smtp.gmail.com:587 (TLS)
#   - Nao funciona com a senha normal da conta desde 2022 - use uma
#     "App Password" gerada em https://myaccount.google.com/apppasswords
#     (exige 2FA ativo).
#   - Conta em uso: solucoesassuncao@gmail.com (definida como padrao).
#     Opcionalmente, criar conta Gmail DEDICADA (ex.: pamc.controle@gmail.com)
#     para reduzir risco de bloqueio por automacao suspeita.
#   - From sempre sera o proprio email autenticado (Gmail nao permite
#     enviar "em nome de").
#   - Guia passo a passo em docs/SMTP_GMAIL.md
#
# Outros provedores (alternativas):
#   Mailgun:        smtp.mailgun.org:587 (US) / smtp.eu.mailgun.net:587 (EU)
#                   exige dominio proprio verificado (DNS + DKIM).
#                   Free tier 5k/mes.  Guia antigo em docs/SMTP_MAILGUN.md
#                   (desatualizado - mantido so como referencia).
#   Hostinger:      smtp.hostinger.com:587 (TLS) - plano Business ou superior.
#   Office365:      smtp.office365.com:587 (TLS).
#   SMTP interno:   consultar TI local (gov).
#
# Se EMAIL_HOST ficar vazio em produção, o sistema continua funcionando
# - apenas mostra a senha na tela e loga um warning no envio.
#
# ---- GMAIL (principal) ----
# 1. Conta Google com 2FA ativo.
# 2. Gerar App Password em https://myaccount.google.com/apppasswords
#    (App: "Outro" -> "PAMC Controle"). Copie os 16 caracteres - aparece
#    so uma vez.
# 3. Preencha abaixo (exemplo com a conta padrao do projeto):
#
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=solucoesassuncao@gmail.com
EMAIL_HOST_PASSWORD=abcd efgh ijkl mnop
DEFAULT_FROM_EMAIL=PAMC Controle de Acesso <solucoesassuncao@gmail.com>
SERVER_EMAIL=solucoesassuncao@gmail.com

# =============================================================================
# CONFIGURAÇÕES ESPECÍFICAS DA APLICAÇÃO
# =============================================================================

# Nome da unidade prisional
UNIDADE_PRISIONAL=sua-unidade-prisional-aqui

# Porta do servidor (usado pelo runserver.py)
HTTP_PLATFORM_PORT=8000